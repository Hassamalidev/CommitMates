# CommitMates environment (CLAUDE.md §14.1).
# Copy to .env.local at the repository root and fill in the values. Never commit .env.local.
# Values shown here are the fixed defaults of the local Supabase stack (`pnpm db:start`).

# --- Site (client) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=CommitMates

# --- Supabase ---
# `pnpm db:status` prints the URL and both keys for the local stack.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- Database ---
# Pooled (transaction pooler) connection, used with prepare: false. Locally both point at Postgres directly.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Direct or session connection, for migrations.
DIRECT_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- GitHub ---
# Fine-grained personal access token with public read-only access (docs/runbooks/github-oauth.md).
GITHUB_SERVER_TOKEN=
# Numeric GitHub id of the first admin: https://api.github.com/users/<your-login> -> "id".
BOOTSTRAP_ADMIN_GITHUB_ID=

# --- Secrets (generate your own) ---
# openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_VERSION=1
# Only during key rotation (docs/runbooks/rotate-token-key.md).
TOKEN_ENCRYPTION_KEY_PREV=
# openssl rand -base64 32
OTP_PEPPER=
# openssl rand -hex 32; also stored in Supabase Vault as tick_secret in staging and prod.
JOB_TICK_SECRET=

# --- Email ---
# Locally, the Supabase mail catcher (web UI on http://127.0.0.1:54324). No user or password needed.
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=CommitMates <no-reply@localhost>
# Appended to the User-Agent sent to external data sources.
CONTACT_EMAIL=

# --- Geocoder (Nominatim; switchable without a code change) ---
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
# Format: CommitMates/1.0 (+<site URL>; <contact email>)
GEOCODER_USER_AGENT=

# --- Optional ---
SENTRY_DSN=
LOG_LEVEL=info
