{
  "name": "commitmates",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "lint:root": "eslint \"*.{js,ts}\" scripts e2e --max-warnings 0 --no-error-on-unmatched-pattern",
    "typecheck": "turbo run typecheck",
    "typecheck:root": "tsc --noEmit",
    "test": "turbo run test",
    "build": "turbo run build",
    "format": "prettier --write .",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @commitmates/web build && playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@commitmates/config": "workspace:*",
    "@playwright/test": "^1.64.0",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "^3.9.10",
    "tsx": "catalog:",
    "turbo": "2.11.7",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
