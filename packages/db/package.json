{
  "name": "@commitmates/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./testing": "./src/testing/index.ts",
    "./migrate": "./src/migrate.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env.local src/migrate-cli.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@commitmates/env": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9",
    "zod": "catalog:",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@commitmates/config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "drizzle-kit": "^0.31.11",
    "tsx": "catalog:"
  }
}
